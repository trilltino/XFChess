# Copy to .env (git-ignored) to set the panel's defaults at build time.
# Operators can still override both on the login screen or in Settings.

# Production VPS the SSH tunnel and ops console connect to.
VITE_XFCHESS_VPS_HOST=178.104.55.19
# SSH identity file; OpenSSH expands the leading ~.
VITE_XFCHESS_SSH_KEY=~/.ssh/xfchess_vps
