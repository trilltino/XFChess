# Copy to /opt/xfchess/.env and fill in real values; never commit secrets.

SIGNING_PORT=8090

# ── Database (absolute paths — binary runs from /opt/xfchess) ─────────────────
# These are created automatically on first run
SESSION_DB_URL=sqlite:///opt/xfchess/data/sessions.db?mode=rwc
VAULT_DB_URL=sqlite:///opt/xfchess/data/vault.db?mode=rwc

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX

# Generate with: openssl rand -hex 32  (must be exactly 64 hex chars = 32 bytes)
IDENTITY_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX

# Generate with: openssl rand -hex 32
IDENTITY_SALT=REPLACE_WITH_64_CHAR_HEX

# Match the client relay secret. Generate one with openssl rand -hex 32.
RELAY_SHARED_SECRET=REPLACE_WITH_64_CHAR_HEX

# Optional JWT lifetime override in seconds (default 604800 = 7 days)
# JWT_TTL_SECS=604800

# Admin API key — required for /admin/* and admin-tournament endpoints.
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=REPLACE_WITH_SECURE_RANDOM

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ER_RPC_URL=https://mainnet.magicblock.app/
# TODO: confirm the mainnet Magic Router hostname at docs.magicblock.gg before
# mainnet deploy (only the devnet router, devnet-router.magicblock.app, is
# confirmed as of this writing). Defaulting to ER_RPC_URL until then.
MAGIC_ROUTER_RPC_URL=https://mainnet.magicblock.app/
PROGRAM_ID=8tevgspityTTG45KvvRtWV4GZ2kuGDBYWMXouFGquyDU

# Base58 authority keys. Use distinct keys on mainnet, with treasury held offline.
FEE_PAYER_KEYS=BASE58_PRIVATE_KEY_1,BASE58_PRIVATE_KEY_2
VPS_AUTHORITY_KEY=BASE58_CONSOLIDATED_AUTHORITY_PRIVATE_KEY
KYC_AUTHORITY_KEY=BASE58_CONSOLIDATED_AUTHORITY_PRIVATE_KEY
TOURNAMENT_FEE_RECIPIENT=uLgR6Nx4KqQobj6e2mQUPeWQpMUauDRc2oz6wZg3Y6C

# USDC mint: mainnet EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v;
# devnet 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU.
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

SENDGRID_API_KEY=SG.REPLACE_WITH_REAL_KEY

# Browser admin callers need the matching Tauri or localhost origins in CORS.
ALLOWED_ORIGINS=https://YOUR_DOMAIN,https://www.YOUR_DOMAIN,http://tauri.localhost,https://tauri.localhost,http://localhost:7454
