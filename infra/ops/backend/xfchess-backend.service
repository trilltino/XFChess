[Unit]
Description=XFChess Backend API
After=network.target

# The binary does not implement sd_notify; use Type=simple without WatchdogSec.
[Service]
Type=simple
User=xfchess
WorkingDirectory=/opt/xfchess
ExecStart=/opt/xfchess/signing-server-http
EnvironmentFile=/opt/xfchess/.env
Environment=SIGNING_BIND_ADDRESS=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077

# Harden: no privilege escalation, read-only filesystem except data dir
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/xfchess/data
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
