# Copy to untracked .env for local secrets. Generate hex values with openssl rand -hex 32.

# Solana RPC. Use a keyed provider (Helius/Triton) locally for best speed.
# The keyed URL is a secret because it embeds your API key.
# Example: https://<your-endpoint>.devnet.rpcpool.com/<your-token>
SOLANA_RPC_URL=https://<your-endpoint>.devnet.rpcpool.com/<your-token>
HELIUS_API_KEY=

# Auth / identity-vault crypto (64 hex chars = 32 bytes each)
JWT_SECRET=
IDENTITY_ENCRYPTION_KEY=
IDENTITY_SALT=

# Base58 keypairs. On devnet these may be one consolidated key; on mainnet use
# separate keys. NEVER hardcode these in tracked files.
FEE_PAYER_KEYS=
VPS_AUTHORITY_KEY=
KYC_AUTHORITY_KEY=

ADMIN_API_KEY=dev
